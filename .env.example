# Built-in model server: any OpenAI-compatible /v1 endpoint. In Docker,
# host.docker.internal is the machine running Docker (Ollama: port 11434).
#LLM_URL=http://host.docker.internal:1234/v1
#LLM_MODEL=gemma-4

# Set Home Assistant, Brave Search and Hugging Face credentials in
# Settings > Connections. Configure the Home Assistant server URL there too.
