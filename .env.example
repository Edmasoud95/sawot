# Required
HA_URL=http://homeassistant.local:8123
HA_TOKEN=paste-your-long-lived-access-token-here

# Docker: where LM Studio (or any OpenAI-compatible server) is reachable from
# the container. host.docker.internal is the machine running Docker.
#LM_STUDIO_URL=http://host.docker.internal:1234/v1
#LM_STUDIO_MODEL=qwen3-8b

# Needed only for gated Hugging Face models (e.g. Cohere Transcribe); a token
# from `hf auth login` works too.
#HF_TOKEN=hf_...
